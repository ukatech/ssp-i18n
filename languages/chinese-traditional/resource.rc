IDR_SAKURA_MENU MENU DISCARDABLE 
BEGIN
    POPUP "sakura"
    BEGIN
        POPUP "推薦網站(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "入口網站(&T)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM "網路更新(&N)\tCtrl+U",     SAKURA_MENU_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "解除安裝(&U)",                  SAKURA_MENU_UNINSTALL
        MENUITEM SEPARATOR
        POPUP "RSS/新聞(&H)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "外掛程式(&P)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "檢查郵件(&M)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "檢查所有帳戶(&A)",         SAKURA_MENU_POP_ALLCHECK
        END
        POPUP "外殼縮放(&E)"
        BEGIN
            MENUITEM "其他設定（同人格設定）", 
                                                    SAKURA_MENU_SETUP_GHOST
            MENUITEM "其他比例(&O)...",        SAKURA_MENU_SCALING_FREE
            MENUITEM SEPARATOR
        END
        POPUP "對話方塊縮放(&D)"
        BEGIN
            MENUITEM "其他比例(&O)...",        SAKURA_MENU_SCALING_BALLOON_FREE

            MENUITEM SEPARATOR
        END
        POPUP "公用程式(&F)"
        BEGIN
            MENUITEM "行事曆(&C)\tCtrl+D",           SAKURA_MENU_CALENDAR
            MENUITEM "SSP 即時通訊(&M)\tCtrl+M",      SAKURA_MENU_IM
            MENUITEM "NTP 時間同步(&N)",              SAKURA_MENU_SNTP
            MENUITEM "資源管理器(&E)\tCtrl+E",           SAKURA_MENU_EXPLORER
            MENUITEM "圖片檢視器",              SAKURA_MENU_PICTURE_VIEWER

            MENUITEM "壓縮檔檢視器",              SAKURA_MENU_ARCHIVE_VIEWER

            MENUITEM "對話記錄/歷史\tCtrl+B",     SAKURA_MENU_BACKLOG_VIEWER

            MENUITEM "檢查 SSP 更新(&U)",      SAKURA_MENU_CHECKUPDATE
            MENUITEM SEPARATOR
            MENUITEM "語音辨識(&T)",     SAKURA_MENU_DICTATION
            MENUITEM "語音合成(&V)",            SAKURA_MENU_TTS
            MENUITEM SEPARATOR
            MENUITEM "網址列(&A)\tCtrl+Shift+U",  SAKURA_MENU_ADDRESSBAR
            MENUITEM "開啟檔案(&I)\tCtrl+O",      SAKURA_MENU_OPENFILE
            MENUITEM "開啟資料夾(&F)\tCtrl+F",    SAKURA_MENU_OPENDIR
            MENUITEM SEPARATOR
            MENUITEM "腳本記錄(&L)\tCtrl+L",         SAKURA_MENU_SCRIPTLOG
            MENUITEM "開發者介面(&D)\tCtrl+Shift+D", 
                                                    SAKURA_MENU_DEVELOPER
            MENUITEM SEPARATOR
            MENUITEM "清除人格快取(&G)",          SAKURA_MENU_PURGEGHOSTCACHE

            MENUITEM "更新 FMO(&F)",                 SAKURA_MENU_UPDATEFMO
            MENUITEM "重新載入所有資料夾(&R)",         SAKURA_MENU_RELOADINFO
            MENUITEM SEPARATOR
            MENUITEM "重新載入人格(&O)",               SAKURA_MENU_RELOADGHOST
            MENUITEM "解除被動模式(&P)",         SAKURA_MENU_LEAVEPASSIVE
            MENUITEM "保留臨時人格(&K)\tCtrl+K", SAKURA_MENU_KEEPGHOST
            MENUITEM SEPARATOR
            MENUITEM "重設外殼位置(&H)\tCtrl+Shift+F12", 
                                                    SAKURA_MENU_RESETPOS
            MENUITEM "重設對話方塊位置(&N)\tCtrl+Shift+F10", 
                                                    SAKURA_MENU_RESETBALLOON
            MENUITEM "隱藏所有對話方塊(&B)\tCtrl+Shift+Del", 
                                                    SAKURA_MENU_CLOSEBALLOON
        END
        POPUP "選項(&O)"
        BEGIN
            MENUITEM "偏好設定(&P)...",             SAKURA_MENU_SETUP
            MENUITEM "人格設定...",        SAKURA_MENU_SETUP_GHOST
            MENUITEM SEPARATOR
            MENUITEM "視窗模式 - 關閉",           SAKURA_MENU_WINDOWMODE_OFF

            MENUITEM "視窗模式 - 所有人格共用",    SAKURA_MENU_WINDOWMODE_SHARED

            MENUITEM "視窗模式 - 每個人格獨立",    SAKURA_MENU_WINDOWMODE_PERGHOST

            MENUITEM SEPARATOR
            MENUITEM "啟用 Proxy(&X)",               SAKURA_MENU_PROXY
            MENUITEM "設定預設字元編碼(&C)",        SAKURA_MENU_CHARSET
            MENUITEM SEPARATOR
            MENUITEM "[相容性]",             IDC_STATIC, GRAYED
            MENUITEM "由 SHIORI 觸發隨機對話(&S)",  SAKURA_MENU_TALKSHIORI
            MENUITEM "舊規格支援(&O)",  SAKURA_MENU_COMPATIBLEMODE

        END
        MENUITEM SEPARATOR
        POPUP "切換人格(&G)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "呼叫人格(&Z)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "外殼(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "服裝/換裝(&C)"
        BEGIN
            MENUITEM "換裝管理器(&E)",           SAKURA_MENU_BIND_EXPLORER

            MENUITEM SEPARATOR
        END
        POPUP "對話方塊(&B)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "歷史記錄(&Y)"
        BEGIN
            POPUP "切換人格(&G)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "呼叫人格(&Z)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "對話方塊(&B)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "新聞(&H)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "外掛程式(&P)"
            BEGIN
                MENUITEM SEPARATOR
            END
        END
        MENUITEM SEPARATOR
        POPUP "資訊(&A)"
        BEGIN
            MENUITEM "關於 SSP(&A)...",               SAKURA_MENU_VERSION
            MENUITEM "關於此人格(&G)...",        SAKURA_MENU_GHOSTINFO
            MENUITEM "此人格的使用條款(&T)...",     SAKURA_MENU_GHOSTTERMS
            MENUITEM "說明(&H)",                       SAKURA_MENU_HELP
            MENUITEM SEPARATOR
            MENUITEM "AI 圖表(&I)",                   SAKURA_MENU_AIGRAPH
            MENUITEM "人格使用統計(&R)", SAKURA_MENU_GHOSTTIME
            MENUITEM "輸出系統資訊(&S)",  SAKURA_MENU_SYSTEMINFO
        END
        POPUP "語言(&L)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "使用系統語言(&U)",           SAKURA_MENU_LANG_RESET
        END
        MENUITEM "最小化(&I)\tCtrl+I",            SAKURA_MENU_MINIMIZE
        MENUITEM SEPARATOR
        MENUITEM "關閉(&W)\tCtrl+W",          SAKURA_MENU_CLOSE
        MENUITEM "結束(&X)\tCtrl+Q",           SAKURA_MENU_EXIT
    END
END

IDR_SAKURA_CALENDAR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "行事曆"
    BEGIN
        MENUITEM "編輯行程(&E)",              SAKURA_CALENDAR_MENU_EDIT
        MENUITEM "朗讀行程(&R)",              SAKURA_CALENDAR_MENU_READEVENT

        MENUITEM "今日行程(&T)",           SAKURA_CALENDAR_MENU_TODAYSSCHEDULE

        POPUP "全部刪除(&D)"
        BEGIN
            MENUITEM "當天(&D)",                   SAKURA_CALENDAR_MENU_DELETE

            MENUITEM "本月(&M)",                 SAKURA_CALENDAR_MENU_DELETEMONTH

            MENUITEM "本年(&Y)",                  SAKURA_CALENDAR_MENU_DELETEYEAR

            MENUITEM "此日期之前的全部(&A)",    SAKURA_CALENDAR_MENU_DELETEFROMHERE

            MENUITEM "人格新增的行程(&G)", 
                                                    SAKURA_CALENDAR_MENU_DELETEGHOST

        END
        MENUITEM SEPARATOR
        MENUITEM "上個月(&P)",             SAKURA_CALENDAR_MENU_PREV
        MENUITEM "下個月(&N)",                 SAKURA_CALENDAR_MENU_NEXT
        MENUITEM "本月(&H)",                 SAKURA_CALENDAR_MENU_TODAY
        POPUP "檢視(&V)"
        BEGIN
            MENUITEM "永遠在最上層(&T)",         SAKURA_CALENDAR_MENU_TOPMOST

            MENUITEM "永遠在中央開啟(&C)",      SAKURA_CALENDAR_MENU_CENTER

        END
        POPUP "縮放(&S)"
        BEGIN
            MENUITEM "其他比例(&O)...",        SAKURA_MENU_SCALING_CALENDAR_FREE

            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        POPUP "外觀(&K)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "行程感應器(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "關閉(&X)",                  SAKURA_CALENDAR_MENU_CLOSE
    END
END

IDR_PICTURE_VIEWER_MENU MENU DISCARDABLE 
BEGIN
    POPUP "檔案(&F)"
    BEGIN
        MENUITEM "開啟圖片(&O)...\tCtrl+O",      PICTURE_MENU_OPEN
        MENUITEM "重新載入(&R)\tCtrl+R",             PICTURE_MENU_RELOAD
        MENUITEM "另存新檔(&S)...\tCtrl+S",         PICTURE_MENU_SAVE
    END
    POPUP "編輯(&E)"
    BEGIN
        MENUITEM "複製(&C)\tCtrl+C",               PICTURE_MENU_COPY
