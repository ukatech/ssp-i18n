        MENUITEM "刪除(&D)",                     LIST_DELETE
        MENUITEM "開啟資料夾(&O)\tCtrl+O",        LIST_OPEN
        MENUITEM "前往作者網站(&J)\tCtrl+J", LIST_URLJUMP
        MENUITEM "開啟說明文件(&R)",       LIST_OPEN_README
        MENUITEM SEPARATOR
        MENUITEM "網路更新(&N)\tCtrl+U",     LIST_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "建立更新檔案(&U)",         LIST_UPDATE_CREATE
        MENUITEM "建立 NAR(&N)...",              LIST_CREATE_NAR
        MENUITEM "同時建立兩者(&B)...",             LIST_CREATE_BOTH
        MENUITEM "建立 zip+txt 更新套件(&Z)", LIST_CREATE_ZIPTXT
    END
END

IDR_KERO_MENU MENU DISCARDABLE 
BEGIN
    POPUP "kero"
    BEGIN
        POPUP "推薦網站(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "服裝/換裝(&C)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "關閉\tCtrl+W",               SAKURA_MENU_CLOSE
        MENUITEM "結束(&X)\tCtrl+Q",           SAKURA_MENU_EXIT
    END
END

IDR_MESSENGER_MENU MENU DISCARDABLE 
BEGIN
    POPUP "檔案(&F)"
    BEGIN
        MENUITEM "關閉(&X)",                  IDCLOSE
    END
    POPUP "編輯(&E)"
    BEGIN
        MENUITEM "剪下(&T)\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "複製(&C)\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "貼上(&V)\tCtrl+V",          ID_EDIT_PASTE
        MENUITEM "刪除(&D)\tDel",                ID_EDIT_CLEAR
    END
    POPUP "登錄(&C)"
    BEGIN
        MENUITEM "新增收件者(&N)",           IDC_USERNEW
        MENUITEM "編輯收件者(&E)",             IDC_USERPROP
        MENUITEM "刪除收件者(&D)",           IDC_USERDEL
        MENUITEM SEPARATOR
        MENUITEM "重新整理(&U)",                     IDC_UPDATELIST
        MENUITEM "清除記錄(&C)",                  MESSENGER_MENU_LOGDEL
    END
END

IDR_LISTDIALOG_TOP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "檔案(&F)"
    BEGIN
        MENUITEM "重新載入(&R)",                     LIST_RELOAD
        MENUITEM SEPARATOR
        MENUITEM "關閉(&C)\tAlt+F4",              IDCANCEL
    END
    POPUP "編輯(&E)"
    BEGIN
        MENUITEM "複製(&C)\tCtrl+C",               LIST_COPY
        MENUITEM "全選(&A)\tCtrl+A",         LIST_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "尋找(&F)...\tCtrl+F",            LIST_FIND
        MENUITEM "找下一個(&N)\tF3",              LIST_FIND_NEXT
    END
    POPUP "類型(&T)"
    BEGIN
        MENUITEM "人格(&G)",                      LIST_TYPE_GHOST
        MENUITEM "外殼(&S)",                      LIST_TYPE_SHELL
        MENUITEM "對話方塊(&B)",                    LIST_TYPE_BALLOON
        MENUITEM "新聞(&H)",                   LIST_TYPE_HEADLINE
        MENUITEM "外掛程式(&P)",                     LIST_TYPE_PLUGIN
        MENUITEM "語言(&L)",                   LIST_TYPE_LANGUAGE
        MENUITEM "行事曆外觀(&C)",              LIST_TYPE_CALENDAR_SKIN
        MENUITEM "行程感應器(&E)",            LIST_TYPE_SCHEDULE_SENSOR
    END
    MENUITEM "功能(&U)",                   65535
    POPUP "設定(&C)"
    BEGIN
        MENUITEM "停用自動關閉(&A)",         LIST_PROP_AUTOCLOSE
    END
END


