        MENUITEM SEPARATOR
        MENUITEM "儲存為壓縮檔(&S)...\tCtrl+S", ARCHIVE_MENU_COMPRESS
    END
    POPUP "編輯(&E)"
    BEGIN
        MENUITEM "從清單中移除(&R)\tDel",      ARCHIVE_MENU_DELETE
        MENUITEM "全選(&A)\tCtrl+A",         ARCHIVE_MENU_SELECTALL
