        MENUITEM SEPARATOR
        MENUITEM "왼쪽으로 회전",                 PICTURE_MENU_ROTATE_LEFT
        MENUITEM "오른쪽으로 회전",                PICTURE_MENU_ROTATE_RIGHT
        MENUITEM "좌우 반전",             PICTURE_MENU_FLIP_H
        MENUITEM SEPARATOR
        MENUITEM "검은색 배경",            PICTURE_MENU_BG_BLACK
