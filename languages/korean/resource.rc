IDR_SAKURA_MENU MENU DISCARDABLE 
BEGIN
    POPUP "sakura"
    BEGIN
        POPUP "추천 사이트(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "포털 사이트(&T)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM "네트워크 업데이트(&N)\tCtrl+U",     SAKURA_MENU_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "제거(&U)",                  SAKURA_MENU_UNINSTALL
        MENUITEM SEPARATOR
        POPUP "RSS/헤드라인(&H)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "플러그인(&P)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "메일 확인(&M)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "모든 계정 확인(&A)",         SAKURA_MENU_POP_ALLCHECK
        END
        POPUP "쉘 배율(&E)"
        BEGIN
            MENUITEM "상세 설정 (고스트별 설정과 동일)", 
                                                    SAKURA_MENU_SETUP_GHOST
            MENUITEM "기타 배율(&O)...",        SAKURA_MENU_SCALING_FREE
            MENUITEM SEPARATOR
        END
        POPUP "말풍선 배율(&D)"
        BEGIN
            MENUITEM "기타 배율(&O)...",        SAKURA_MENU_SCALING_BALLOON_FREE

            MENUITEM SEPARATOR
        END
        POPUP "기능(&F)"
        BEGIN
            MENUITEM "캘린더(&C)\tCtrl+D",           SAKURA_MENU_CALENDAR
            MENUITEM "SSP 메신저(&M)\tCtrl+M",      SAKURA_MENU_IM
            MENUITEM "NTP 시간 동기화(&N)",              SAKURA_MENU_SNTP
            MENUITEM "탐색기(&E)\tCtrl+E",           SAKURA_MENU_EXPLORER
            MENUITEM "이미지 뷰어",              SAKURA_MENU_PICTURE_VIEWER

            MENUITEM "압축 파일 뷰어",              SAKURA_MENU_ARCHIVE_VIEWER

            MENUITEM "백로그/대화 기록\tCtrl+B",     SAKURA_MENU_BACKLOG_VIEWER

            MENUITEM "SSP 업데이트 확인(&U)",      SAKURA_MENU_CHECKUPDATE
            MENUITEM SEPARATOR
            MENUITEM "음성 인식(&T)",     SAKURA_MENU_DICTATION
            MENUITEM "음성 합성(&V)",            SAKURA_MENU_TTS
            MENUITEM SEPARATOR
            MENUITEM "주소 표시줄(&A)\tCtrl+Shift+U",  SAKURA_MENU_ADDRESSBAR
            MENUITEM "파일 열기(&I)\tCtrl+O",      SAKURA_MENU_OPENFILE
            MENUITEM "폴더 열기(&F)\tCtrl+F",    SAKURA_MENU_OPENDIR
            MENUITEM SEPARATOR
            MENUITEM "스크립트 로그(&L)\tCtrl+L",         SAKURA_MENU_SCRIPTLOG
            MENUITEM "개발용 팔레트(&D)\tCtrl+Shift+D", 
                                                    SAKURA_MENU_DEVELOPER
            MENUITEM SEPARATOR
            MENUITEM "고스트 캐시 해제(&G)",          SAKURA_MENU_PURGEGHOSTCACHE

            MENUITEM "FMO 정리/업데이트(&F)",                 SAKURA_MENU_UPDATEFMO
            MENUITEM "모든 폴더 정보 다시 읽기(&R)",         SAKURA_MENU_RELOADINFO
            MENUITEM SEPARATOR
            MENUITEM "고스트 다시 읽기(&O)",               SAKURA_MENU_RELOADGHOST
            MENUITEM "제한(패시브) 모드 강제 해제(&P)",         SAKURA_MENU_LEAVEPASSIVE
            MENUITEM "임시 실행 고스트 유지(&K)\tCtrl+K", SAKURA_MENU_KEEPGHOST
            MENUITEM SEPARATOR
            MENUITEM "쉘 위치 초기화(&H)\tCtrl+Shift+F12", 
                                                    SAKURA_MENU_RESETPOS
            MENUITEM "말풍선 위치 초기화(&N)\tCtrl+Shift+F10", 
                                                    SAKURA_MENU_RESETBALLOON
            MENUITEM "모든 말풍선 숨기기(&B)\tCtrl+Shift+Del", 
                                                    SAKURA_MENU_CLOSEBALLOON
        END
        POPUP "설정(&O)"
        BEGIN
            MENUITEM "SSP 설정(&P)...",             SAKURA_MENU_SETUP
            MENUITEM "고스트별 설정...",        SAKURA_MENU_SETUP_GHOST
            MENUITEM SEPARATOR
            MENUITEM "창 모드 - 끔",           SAKURA_MENU_WINDOWMODE_OFF

            MENUITEM "창 모드 - 모든 고스트 공용",    SAKURA_MENU_WINDOWMODE_SHARED

            MENUITEM "창 모드 - 고스트별",    SAKURA_MENU_WINDOWMODE_PERGHOST

            MENUITEM SEPARATOR
            MENUITEM "프록시 서버 사용(&X)",               SAKURA_MENU_PROXY
            MENUITEM "기본 문자 인코딩 설정(&C)",        SAKURA_MENU_CHARSET
            MENUITEM SEPARATOR
            MENUITEM "[호환성]",             IDC_STATIC, GRAYED
            MENUITEM "토크 타이밍을 고스트에 맡김(&S)",  SAKURA_MENU_TALKSHIORI
            MENUITEM "구 사양 지원(&O)",  SAKURA_MENU_COMPATIBLEMODE

        END
        MENUITEM SEPARATOR
        POPUP "고스트 전환(&G)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "다른 고스트 호출(&Z)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "쉘(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "옷 갈아입히기(&C)"
        BEGIN
            MENUITEM "옷 갈아입히기 탐색기(&E)",           SAKURA_MENU_BIND_EXPLORER

            MENUITEM SEPARATOR
        END
        POPUP "말풍선(&B)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "최근 사용(&Y)"
        BEGIN
            POPUP "고스트 전환(&G)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "다른 고스트 호출(&Z)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "말풍선(&B)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "헤드라인(&H)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "플러그인(&P)"
            BEGIN
                MENUITEM SEPARATOR
            END
        END
        MENUITEM SEPARATOR
        POPUP "정보(&A)"
        BEGIN
            MENUITEM "SSP 정보(&A)...",               SAKURA_MENU_VERSION
            MENUITEM "이 고스트 정보(&G)...",        SAKURA_MENU_GHOSTINFO
            MENUITEM "이 고스트의 이용 조건(&T)...",     SAKURA_MENU_GHOSTTERMS
            MENUITEM "도움말(&H)",                       SAKURA_MENU_HELP
            MENUITEM SEPARATOR
            MENUITEM "AI 그래프(&I)",                   SAKURA_MENU_AIGRAPH
            MENUITEM "사용 빈도 표시(&R)", SAKURA_MENU_GHOSTTIME
            MENUITEM "시스템 정보 내보내기(&S)",  SAKURA_MENU_SYSTEMINFO
        END
        POPUP "언어(&L)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "시스템 언어 사용(&U)",           SAKURA_MENU_LANG_RESET
        END
        MENUITEM "최소화(&I)\tCtrl+I",            SAKURA_MENU_MINIMIZE
        MENUITEM SEPARATOR
        MENUITEM "종료(&W)\tCtrl+W",          SAKURA_MENU_CLOSE
        MENUITEM "모두 종료(&X)\tCtrl+Q",           SAKURA_MENU_EXIT
    END
END

IDR_SAKURA_CALENDAR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "캘린더"
    BEGIN
        MENUITEM "일정 편집(&E)",              SAKURA_CALENDAR_MENU_EDIT
        MENUITEM "일정 읽어 주기(&R)",              SAKURA_CALENDAR_MENU_READEVENT

        MENUITEM "오늘의 일정(&T)",           SAKURA_CALENDAR_MENU_TODAYSSCHEDULE

        POPUP "모두 삭제(&D)"
        BEGIN
            MENUITEM "이 날(&D)",                   SAKURA_CALENDAR_MENU_DELETE

            MENUITEM "이번 달(&M)",                 SAKURA_CALENDAR_MENU_DELETEMONTH

            MENUITEM "올해(&Y)",                  SAKURA_CALENDAR_MENU_DELETEYEAR

