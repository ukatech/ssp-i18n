    BEGIN
        MENUITEM "실제 크기(&A)\tCtrl+0",        PICTURE_MENU_SAME
        MENUITEM "확대(&I)\tCtrl++",            PICTURE_MENU_ZOOMIN
        MENUITEM "축소(&O)\tCtrl+-",           PICTURE_MENU_ZOOMOUT
        MENUITEM "창에 맞추기(&W)",              PICTURE_MENU_FIT
