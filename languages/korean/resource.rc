        MENUITEM "이전 달(&P)",             SAKURA_CALENDAR_MENU_PREV
        MENUITEM "다음 달(&N)",                 SAKURA_CALENDAR_MENU_NEXT
        MENUITEM "이번 달(&H)",                 SAKURA_CALENDAR_MENU_TODAY
        POPUP "보기(&V)"
        BEGIN
            MENUITEM "항상 위에 표시(&T)",         SAKURA_CALENDAR_MENU_TOPMOST

            MENUITEM "항상 화면 가운데에 표시(&C)",      SAKURA_CALENDAR_MENU_CENTER

        END
        POPUP "표시 배율(&S)"
        BEGIN
            MENUITEM "기타 배율(&O)...",        SAKURA_MENU_SCALING_CALENDAR_FREE

            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        POPUP "스킨(&K)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "일정 센서(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "닫기(&X)",                  SAKURA_CALENDAR_MENU_CLOSE
    END
END

IDR_PICTURE_VIEWER_MENU MENU DISCARDABLE 
