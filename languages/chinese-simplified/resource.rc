        MENUITEM "添加文件夹(&F)...",              ARCHIVE_MENU_ADDFOLDER
        MENUITEM SEPARATOR
        MENUITEM "保存为压缩包(&S)...\tCtrl+S", ARCHIVE_MENU_COMPRESS
    END
    POPUP "编辑(&E)"
    BEGIN
