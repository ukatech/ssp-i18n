IDR_KERO_MENU MENU DISCARDABLE 
BEGIN
    POPUP "kero"
    BEGIN
        POPUP "推荐网站(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "服装/换装(&C)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "关闭\tCtrl+W",               SAKURA_MENU_CLOSE
        MENUITEM "退出(&X)\tCtrl+Q",           SAKURA_MENU_EXIT
    END
END

IDR_MESSENGER_MENU MENU DISCARDABLE 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "关闭(&X)",                  IDCLOSE
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "剪切(&T)\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "粘贴(&V)\tCtrl+V",          ID_EDIT_PASTE
        MENUITEM "删除(&D)\tDel",                ID_EDIT_CLEAR
    END
    POPUP "登记(&C)"
    BEGIN
        MENUITEM "添加收件人(&N)",           IDC_USERNEW
        MENUITEM "编辑收件人(&E)",             IDC_USERPROP
        MENUITEM "删除收件人(&D)",           IDC_USERDEL
        MENUITEM SEPARATOR
        MENUITEM "刷新(&U)",                     IDC_UPDATELIST
        MENUITEM "清除日志(&C)",                  MESSENGER_MENU_LOGDEL
    END
END

IDR_LISTDIALOG_TOP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "重新载入(&R)",                     LIST_RELOAD
        MENUITEM SEPARATOR
        MENUITEM "关闭(&C)\tAlt+F4",              IDCANCEL
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "复制(&C)\tCtrl+C",               LIST_COPY
        MENUITEM "全选(&A)\tCtrl+A",         LIST_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "查找(&F)...\tCtrl+F",            LIST_FIND
        MENUITEM "查找下一个(&N)\tF3",              LIST_FIND_NEXT
    END
    POPUP "类型(&T)"
    BEGIN
        MENUITEM "人格(&G)",                      LIST_TYPE_GHOST
        MENUITEM "外壳(&S)",                      LIST_TYPE_SHELL
        MENUITEM "对话框(&B)",                    LIST_TYPE_BALLOON
        MENUITEM "新闻(&H)",                   LIST_TYPE_HEADLINE
        MENUITEM "插件(&P)",                     LIST_TYPE_PLUGIN
        MENUITEM "语言(&L)",                   LIST_TYPE_LANGUAGE
        MENUITEM "日历皮肤(&C)",              LIST_TYPE_CALENDAR_SKIN
        MENUITEM "日程传感器(&E)",            LIST_TYPE_SCHEDULE_SENSOR
    END
    MENUITEM "功能(&U)",                   65535
    POPUP "设置(&C)"
    BEGIN
        MENUITEM "禁用自动关闭(&A)",         LIST_PROP_AUTOCLOSE
    END
END


