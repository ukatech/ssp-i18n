IDR_SAKURA_MENU MENU DISCARDABLE 
BEGIN
    POPUP "sakura"
    BEGIN
        POPUP "推荐网站(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "门户网站(&T)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM "网络更新(&N)\tCtrl+U",     SAKURA_MENU_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "卸载(&U)",                  SAKURA_MENU_UNINSTALL
        MENUITEM SEPARATOR
        POPUP "RSS/新闻(&H)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "插件(&P)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "检查邮件(&M)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "检查所有账户(&A)",         SAKURA_MENU_POP_ALLCHECK
        END
        POPUP "外壳缩放(&E)"
        BEGIN
            MENUITEM "其他设置（同人格设置）", 
                                                    SAKURA_MENU_SETUP_GHOST
            MENUITEM "其他比例(&O)...",        SAKURA_MENU_SCALING_FREE
            MENUITEM SEPARATOR
        END
        POPUP "对话框缩放(&D)"
        BEGIN
            MENUITEM "其他比例(&O)...",        SAKURA_MENU_SCALING_BALLOON_FREE

            MENUITEM SEPARATOR
        END
        POPUP "实用工具(&F)"
        BEGIN
            MENUITEM "日历(&C)\tCtrl+D",           SAKURA_MENU_CALENDAR
            MENUITEM "SSP 即时通讯(&M)\tCtrl+M",      SAKURA_MENU_IM
            MENUITEM "NTP 时间同步(&N)",              SAKURA_MENU_SNTP
            MENUITEM "资源管理器(&E)\tCtrl+E",           SAKURA_MENU_EXPLORER
            MENUITEM "图片查看器",              SAKURA_MENU_PICTURE_VIEWER

            MENUITEM "压缩包查看器",              SAKURA_MENU_ARCHIVE_VIEWER

            MENUITEM "对话记录/历史\tCtrl+B",     SAKURA_MENU_BACKLOG_VIEWER

            MENUITEM "检查 SSP 更新(&U)",      SAKURA_MENU_CHECKUPDATE
            MENUITEM SEPARATOR
            MENUITEM "语音识别(&T)",     SAKURA_MENU_DICTATION
            MENUITEM "语音合成(&V)",            SAKURA_MENU_TTS
            MENUITEM SEPARATOR
            MENUITEM "地址栏(&A)\tCtrl+Shift+U",  SAKURA_MENU_ADDRESSBAR
            MENUITEM "打开文件(&I)\tCtrl+O",      SAKURA_MENU_OPENFILE
            MENUITEM "打开文件夹(&F)\tCtrl+F",    SAKURA_MENU_OPENDIR
            MENUITEM SEPARATOR
            MENUITEM "脚本日志(&L)\tCtrl+L",         SAKURA_MENU_SCRIPTLOG
            MENUITEM "开发者界面(&D)\tCtrl+Shift+D", 
                                                    SAKURA_MENU_DEVELOPER
            MENUITEM SEPARATOR
            MENUITEM "清除人格缓存(&G)",          SAKURA_MENU_PURGEGHOSTCACHE

            MENUITEM "更新 FMO(&F)",                 SAKURA_MENU_UPDATEFMO
            MENUITEM "重新载入所有文件夹(&R)",         SAKURA_MENU_RELOADINFO
            MENUITEM SEPARATOR
            MENUITEM "重新载入人格(&O)",               SAKURA_MENU_RELOADGHOST
            MENUITEM "解除被动模式(&P)",         SAKURA_MENU_LEAVEPASSIVE
            MENUITEM "保留临时人格(&K)\tCtrl+K", SAKURA_MENU_KEEPGHOST
            MENUITEM SEPARATOR
            MENUITEM "重置外壳位置(&H)\tCtrl+Shift+F12", 
                                                    SAKURA_MENU_RESETPOS
            MENUITEM "重置对话框位置(&N)\tCtrl+Shift+F10", 
                                                    SAKURA_MENU_RESETBALLOON
            MENUITEM "隐藏所有对话框(&B)\tCtrl+Shift+Del", 
                                                    SAKURA_MENU_CLOSEBALLOON
        END
        POPUP "选项(&O)"
        BEGIN
            MENUITEM "首选项(&P)...",             SAKURA_MENU_SETUP
            MENUITEM "人格设置...",        SAKURA_MENU_SETUP_GHOST
            MENUITEM SEPARATOR
            MENUITEM "窗口模式 - 关闭",           SAKURA_MENU_WINDOWMODE_OFF

            MENUITEM "窗口模式 - 所有人格共用",    SAKURA_MENU_WINDOWMODE_SHARED

            MENUITEM "窗口模式 - 每个人格独立",    SAKURA_MENU_WINDOWMODE_PERGHOST

            MENUITEM SEPARATOR
            MENUITEM "启用代理(&X)",               SAKURA_MENU_PROXY
            MENUITEM "设置默认字符编码(&C)",        SAKURA_MENU_CHARSET
            MENUITEM SEPARATOR
            MENUITEM "[兼容性]",             IDC_STATIC, GRAYED
            MENUITEM "由 SHIORI 触发随机对话(&S)",  SAKURA_MENU_TALKSHIORI
            MENUITEM "旧规格支持(&O)",  SAKURA_MENU_COMPATIBLEMODE

        END
        MENUITEM SEPARATOR
        POPUP "切换人格(&G)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "呼叫人格(&Z)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "外壳(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "服装/换装(&C)"
        BEGIN
            MENUITEM "换装管理器(&E)",           SAKURA_MENU_BIND_EXPLORER

            MENUITEM SEPARATOR
        END
        POPUP "对话框(&B)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "历史记录(&Y)"
        BEGIN
            POPUP "切换人格(&G)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "呼叫人格(&Z)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "对话框(&B)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "新闻(&H)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "插件(&P)"
            BEGIN
                MENUITEM SEPARATOR
            END
        END
        MENUITEM SEPARATOR
        POPUP "信息(&A)"
        BEGIN
            MENUITEM "关于 SSP(&A)...",               SAKURA_MENU_VERSION
            MENUITEM "关于此人格(&G)...",        SAKURA_MENU_GHOSTINFO
            MENUITEM "此人格的使用条款(&T)...",     SAKURA_MENU_GHOSTTERMS
            MENUITEM "帮助(&H)",                       SAKURA_MENU_HELP
            MENUITEM SEPARATOR
            MENUITEM "AI 图表(&I)",                   SAKURA_MENU_AIGRAPH
            MENUITEM "人格使用统计(&R)", SAKURA_MENU_GHOSTTIME
            MENUITEM "输出系统信息(&S)",  SAKURA_MENU_SYSTEMINFO
        END
        POPUP "语言(&L)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "使用系统语言(&U)",           SAKURA_MENU_LANG_RESET
        END
        MENUITEM "最小化(&I)\tCtrl+I",            SAKURA_MENU_MINIMIZE
        MENUITEM SEPARATOR
        MENUITEM "关闭(&W)\tCtrl+W",          SAKURA_MENU_CLOSE
        MENUITEM "退出(&X)\tCtrl+Q",           SAKURA_MENU_EXIT
    END
END

IDR_SAKURA_CALENDAR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "日历"
    BEGIN
        MENUITEM "编辑日程(&E)",              SAKURA_CALENDAR_MENU_EDIT
        MENUITEM "朗读日程(&R)",              SAKURA_CALENDAR_MENU_READEVENT

        MENUITEM "今日日程(&T)",           SAKURA_CALENDAR_MENU_TODAYSSCHEDULE

        POPUP "全部删除(&D)"
        BEGIN
            MENUITEM "当天(&D)",                   SAKURA_CALENDAR_MENU_DELETE

            MENUITEM "本月(&M)",                 SAKURA_CALENDAR_MENU_DELETEMONTH

            MENUITEM "本年(&Y)",                  SAKURA_CALENDAR_MENU_DELETEYEAR

            MENUITEM "此日期之前的全部(&A)",    SAKURA_CALENDAR_MENU_DELETEFROMHERE

            MENUITEM "人格添加的日程(&G)", 
                                                    SAKURA_CALENDAR_MENU_DELETEGHOST

        END
        MENUITEM SEPARATOR
        MENUITEM "上个月(&P)",             SAKURA_CALENDAR_MENU_PREV
        MENUITEM "下个月(&N)",                 SAKURA_CALENDAR_MENU_NEXT
        MENUITEM "本月(&H)",                 SAKURA_CALENDAR_MENU_TODAY
        POPUP "查看(&V)"
        BEGIN
            MENUITEM "总在最前(&T)",         SAKURA_CALENDAR_MENU_TOPMOST

            MENUITEM "总在中央打开(&C)",      SAKURA_CALENDAR_MENU_CENTER

        END
        POPUP "缩放(&S)"
        BEGIN
            MENUITEM "其他比例(&O)...",        SAKURA_MENU_SCALING_CALENDAR_FREE

            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        POPUP "皮肤(&K)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "日程传感器(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "关闭(&X)",                  SAKURA_CALENDAR_MENU_CLOSE
    END
END

IDR_PICTURE_VIEWER_MENU MENU DISCARDABLE 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开图片(&O)...\tCtrl+O",      PICTURE_MENU_OPEN
        MENUITEM "重新载入(&R)\tCtrl+R",             PICTURE_MENU_RELOAD
        MENUITEM "另存为(&S)...\tCtrl+S",         PICTURE_MENU_SAVE
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "复制(&C)\tCtrl+C",               PICTURE_MENU_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",              PICTURE_MENU_PASTE
        MENUITEM "调整大小(&Z)...",                  PICTURE_MENU_RESIZE
        MENUITEM SEPARATOR
        MENUITEM "裁剪",                        PICTURE_MENU_TRIM
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "实际大小(&A)\tCtrl+0",        PICTURE_MENU_SAME
        MENUITEM "放大(&I)\tCtrl++",            PICTURE_MENU_ZOOMIN
        MENUITEM "缩小(&O)\tCtrl+-",           PICTURE_MENU_ZOOMOUT
        MENUITEM "适应窗口(&W)",              PICTURE_MENU_FIT
        MENUITEM "设置缩放比例(&Z)...",          PICTURE_MENU_ZOOMCUSTOM
        MENUITEM SEPARATOR
        MENUITEM "上一页",               PICTURE_MENU_PREV
        MENUITEM "下一页",                   PICTURE_MENU_NEXT
        MENUITEM SEPARATOR
        MENUITEM "向左旋转",                 PICTURE_MENU_ROTATE_LEFT
        MENUITEM "向右旋转",                PICTURE_MENU_ROTATE_RIGHT
        MENUITEM "水平翻转",             PICTURE_MENU_FLIP_H
        MENUITEM SEPARATOR
        MENUITEM "黑色背景",            PICTURE_MENU_BG_BLACK
        MENUITEM "白色背景",            PICTURE_MENU_BG_WHITE
        MENUITEM "棋盘格背景",        PICTURE_MENU_BG_CHECKER
        MENUITEM SEPARATOR
        MENUITEM "将左上角颜色设为透明", PICTURE_MENU_COLORKEY
    END
END

IDR_ARCHIVE_VIEWER_MENU MENU DISCARDABLE 
