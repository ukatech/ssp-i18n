        MENUITEM "配布元URLを開く(&J)\tCtrl+J", LIST_URLJUMP
        MENUITEM "READMEを開く(&R)",            LIST_OPEN_README
        MENUITEM SEPARATOR
        MENUITEM "ネットワーク更新(&N)\tCtrl+U", LIST_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "更新ファイル作成(&U)",        LIST_UPDATE_CREATE
        MENUITEM "NAR作成...(&A)",              LIST_CREATE_NAR
        MENUITEM "更新/NAR両方作成(&B)",        LIST_CREATE_BOTH
        MENUITEM "&Zip+Txt更新ファイル作成",    LIST_CREATE_ZIPTXT
    END
END

IDR_KERO_MENU MENU DISCARDABLE 
BEGIN
    POPUP "kero"
    BEGIN
        POPUP "おすすめ(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "着せ替え(&C)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "終了\tCtrl+W",                SAKURA_MENU_CLOSE
        MENUITEM "全て終了(&X)\tCtrl+Q",        SAKURA_MENU_EXIT
    END
END

IDR_MESSENGER_MENU MENU DISCARDABLE 
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "閉じる(&X)",                  IDCLOSE
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "切り取り(&T)\tCtrl+X",        ID_EDIT_CUT
        MENUITEM "コピー(&C)\tCtrl+C",          ID_EDIT_COPY
        MENUITEM "貼り付け(&V)\tCtlr+V",        ID_EDIT_PASTE
        MENUITEM "削除(&D)\tDel",               ID_EDIT_CLEAR
    END
    POPUP "登録(&C)"
    BEGIN
        MENUITEM "宛先の追加(&N)",              IDC_USERNEW
        MENUITEM "宛先の編集(&E)",              IDC_USERPROP
        MENUITEM "宛先の削除(&D)",              IDC_USERDEL
        MENUITEM SEPARATOR
        MENUITEM "情報の更新(&U)",              IDC_UPDATELIST
        MENUITEM "ログ消去(&C)",                MESSENGER_MENU_LOGDEL
    END
END

IDR_LISTDIALOG_TOP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "再読み込み(&R)",              LIST_RELOAD
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&C)\tAlt+F4",          IDCANCEL
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "コピー(&C)\tCtrl+C",          LIST_COPY
        MENUITEM "すべて選択(&A)\tCtrl+A",      LIST_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "検索(&F)...\tCtrl+F",         LIST_FIND
        MENUITEM "次を検索(&N)\tF3",            LIST_FIND_NEXT
    END
    POPUP "種類(&T)"
    BEGIN
        MENUITEM "ゴースト(&G)",                LIST_TYPE_GHOST
        MENUITEM "シェル(&S)",                  LIST_TYPE_SHELL
        MENUITEM "バルーン(&B)",                LIST_TYPE_BALLOON
        MENUITEM "ヘッドライン(&H)",            LIST_TYPE_HEADLINE
        MENUITEM "プラグイン(&P)",              LIST_TYPE_PLUGIN
        MENUITEM "&Language",                   LIST_TYPE_LANGUAGE
        MENUITEM "カレンダースキン(&C)",        LIST_TYPE_CALENDAR_SKIN
        MENUITEM "スケジュールセンサ(&E)",      LIST_TYPE_SCHEDULE_SENSOR
    END
    MENUITEM "機能(&U)",                    65535
    POPUP "設定(&C)"
    BEGIN
        MENUITEM "自動で閉じない(&A)",          LIST_PROP_AUTOCLOSE
    END
END


