IDR_SAKURA_MENU MENU DISCARDABLE 
BEGIN
    POPUP "sakura"
    BEGIN
        POPUP "おすすめ(&R)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "ポータルサイト(&T)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM "ネットワーク更新(&N)",        SAKURA_MENU_UPDATE
        MENUITEM SEPARATOR
        MENUITEM "アンインストール(&U)",        SAKURA_MENU_UNINSTALL
        MENUITEM SEPARATOR
        POPUP "RSS/ヘッドライン(&H)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "プラグイン(&P)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "メールチェック(&M)"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "全てチェック(&A)",            SAKURA_MENU_POP_ALLCHECK
        END
        POPUP "シェル倍率(&E)"
        BEGIN
            MENUITEM "詳細設定(ゴーストごとの設定) (&D)...", 
                                                    SAKURA_MENU_SETUP_GHOST
            MENUITEM "その他の倍率(&O)...",         SAKURA_MENU_SCALING_FREE
            MENUITEM SEPARATOR
        END
        POPUP "バルーン倍率(&D)"
        BEGIN
            MENUITEM "その他の倍率(&O)...",         SAKURA_MENU_SCALING_BALLOON_FREE

            MENUITEM SEPARATOR
        END
        POPUP "機能(&F)"
        BEGIN
            MENUITEM "カレンダー(&C)\tCtrl+D",      SAKURA_MENU_CALENDAR
            MENUITEM "SSPメッセンジャ(&M)\tCtrl+M", SAKURA_MENU_IM
            MENUITEM "時刻合わせ(&N)",              SAKURA_MENU_SNTP
            MENUITEM "エクスプローラ(&E)\tCtrl+E",  SAKURA_MENU_EXPLORER
            MENUITEM "画像ビューワ",                SAKURA_MENU_PICTURE_VIEWER

            MENUITEM "アーカイブビューワ",          SAKURA_MENU_ARCHIVE_VIEWER

            MENUITEM "バックログ/発言履歴\tCtrl+B", SAKURA_MENU_BACKLOG_VIEWER

            MENUITEM "本体更新をチェック(&U)",      SAKURA_MENU_CHECKUPDATE
            MENUITEM SEPARATOR
            MENUITEM "音声認識(&T)",                SAKURA_MENU_DICTATION
            MENUITEM "音声合成(&V)",                SAKURA_MENU_TTS
            MENUITEM SEPARATOR
            MENUITEM "アドレスバー(&A)\tCtrl+Shift+U", 
                                                    SAKURA_MENU_ADDRESSBAR
            MENUITEM "ファイルを開く(&I)\tCtrl+O",  SAKURA_MENU_OPENFILE
            MENUITEM "フォルダを選択する(&S)\tCtrl+F", SAKURA_MENU_OPENDIR
            MENUITEM SEPARATOR
            MENUITEM "スクリプトログ(&L)\tCtrl+L",  SAKURA_MENU_SCRIPTLOG
            MENUITEM "開発用パレット(&D)\tCtrl+Shift+D", 
                                                    SAKURA_MENU_DEVELOPER
            MENUITEM SEPARATOR
            MENUITEM "ゴーストキャッシュ開放(&G)",  SAKURA_MENU_PURGEGHOSTCACHE

            MENUITEM "FMOの整理／更新(&F)",         SAKURA_MENU_UPDATEFMO
            MENUITEM "動作情報再読み込み(&R)",      SAKURA_MENU_RELOADINFO
            MENUITEM SEPARATOR
            MENUITEM "ゴースト再読み込み(&O)",      SAKURA_MENU_RELOADGHOST
            MENUITEM "制限モード強制解除(&P)",      SAKURA_MENU_LEAVEPASSIVE
            MENUITEM "一時起動ゴーストを保持(&K)\tCtrl+K", 
                                                    SAKURA_MENU_KEEPGHOST
            MENUITEM SEPARATOR
            MENUITEM "シェル位置初期化(&H)\tCtrl+Shift+F12", 
                                                    SAKURA_MENU_RESETPOS
            MENUITEM "バルーン位置初期化(&N)\tCtrl+Shift+F10", 
                                                    SAKURA_MENU_RESETBALLOON
            MENUITEM "バルーンを消す(&B)\tCtrl+Shift+Del", 
                                                    SAKURA_MENU_CLOSEBALLOON
        END
        POPUP "設定(&O)"
        BEGIN
            MENUITEM "本体設定...(&P)",             SAKURA_MENU_SETUP
            MENUITEM "ゴーストごとの設定...(&G)",   SAKURA_MENU_SETUP_GHOST
            MENUITEM SEPARATOR
            MENUITEM "ウインドウモード - 切",       SAKURA_MENU_WINDOWMODE_OFF

            MENUITEM "ウインドウモード - 全ゴースト", 
                                                    SAKURA_MENU_WINDOWMODE_SHARED

            MENUITEM "ウインドウモード - ゴーストごと", 
                                                    SAKURA_MENU_WINDOWMODE_PERGHOST

            MENUITEM SEPARATOR
            MENUITEM "プロキシサーバを有効にする(&X)", SAKURA_MENU_PROXY
            MENUITEM "文字コード設定(&C)",          SAKURA_MENU_CHARSET
            MENUITEM SEPARATOR
            MENUITEM "[旧互換機能]",                65535, GRAYED
            MENUITEM "話すタイミングをゴースト任せ(&L)", 
                                                    SAKURA_MENU_TALKSHIORI
            MENUITEM "旧仕様サポート(&O)",          SAKURA_MENU_COMPATIBLEMODE

        END
        MENUITEM SEPARATOR
        POPUP "ゴースト切り替え(&G)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "他のゴーストを呼ぶ（&Z)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "シェル(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "着せ替え(&C)"
        BEGIN
            MENUITEM "着せ替えエクスプローラ(&E)",  SAKURA_MENU_BIND_EXPLORER

            MENUITEM SEPARATOR
        END
        POPUP "バルーン(&B)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "最近使ったもの(&Y)"
        BEGIN
            POPUP "ゴーストに切り替え(&G)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "他のゴーストを呼ぶ(&Z)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "バルーン(&B)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "ヘッドライン(&H)"
            BEGIN
                MENUITEM SEPARATOR
            END
            POPUP "プラグイン(&P)"
            BEGIN
                MENUITEM SEPARATOR
            END
        END
        MENUITEM SEPARATOR
        POPUP "情報(&A)"
        BEGIN
            MENUITEM "SSPについて(&A)",             SAKURA_MENU_VERSION
            MENUITEM "キャラクタについて(&G)",      SAKURA_MENU_GHOSTINFO
            MENUITEM "キャラクタの利用条件(&T)",    SAKURA_MENU_GHOSTTERMS
            MENUITEM "説明書(&H)",                  SAKURA_MENU_HELP
            MENUITEM SEPARATOR
            MENUITEM "AIグラフ(&I)",                SAKURA_MENU_AIGRAPH
            MENUITEM "使用頻度表示(&R)",            SAKURA_MENU_GHOSTTIME
            MENUITEM "システム情報を書出(&S)",      SAKURA_MENU_SYSTEMINFO
        END
        POPUP "&Language"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "&Use System Lang.",           SAKURA_MENU_LANG_RESET
        END
        MENUITEM "アイコン化(&I)\tCtrl+I",      SAKURA_MENU_MINIMIZE
        MENUITEM SEPARATOR
        MENUITEM "終了(&W)\tCtrl+W",            SAKURA_MENU_CLOSE
        MENUITEM "全て終了(&X)\tCtrl+Q",        SAKURA_MENU_EXIT
    END
END

IDR_SAKURA_CALENDAR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "Calendar"
    BEGIN
        MENUITEM "スケジュール編集(&E)",        SAKURA_CALENDAR_MENU_EDIT
        MENUITEM "予定を読む(&R)",              SAKURA_CALENDAR_MENU_READEVENT

        MENUITEM "今日の予定(&T)",              SAKURA_CALENDAR_MENU_TODAYSSCHEDULE

        POPUP "すべて削除(&D)"
        BEGIN
            MENUITEM "この日(&D)",                  SAKURA_CALENDAR_MENU_DELETE

            MENUITEM "この月(&M)",                  SAKURA_CALENDAR_MENU_DELETEMONTH

            MENUITEM "この年(&Y)",                  SAKURA_CALENDAR_MENU_DELETEYEAR

            MENUITEM "この日より前全て(&A)",        SAKURA_CALENDAR_MENU_DELETEFROMHERE

            MENUITEM "ゴーストが登録した予定(&G)",  SAKURA_CALENDAR_MENU_DELETEGHOST

        END
        MENUITEM SEPARATOR
        MENUITEM "前月(&P)",                    SAKURA_CALENDAR_MENU_PREV
        MENUITEM "次月(&N)",                    SAKURA_CALENDAR_MENU_NEXT
        MENUITEM "今月(&H)",                    SAKURA_CALENDAR_MENU_TODAY
        POPUP "表示(&V)"
        BEGIN
            MENUITEM "常に手前に表示(&T)",          SAKURA_CALENDAR_MENU_TOPMOST

            MENUITEM "常に画面中央に表示(&C)",      SAKURA_CALENDAR_MENU_CENTER

        END
        POPUP "表示倍率(&S)"
        BEGIN
            MENUITEM "その他の倍率(&O)...",         SAKURA_MENU_SCALING_CALENDAR_FREE

            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        POPUP "スキン(&K)"
        BEGIN
            MENUITEM SEPARATOR
        END
        POPUP "スケジュールセンサ(&S)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&X)",                  SAKURA_CALENDAR_MENU_CLOSE
    END
END

IDR_PICTURE_VIEWER_MENU MENU DISCARDABLE 
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "画像を開く(&O)...\tCtrl+O",   PICTURE_MENU_OPEN
        MENUITEM "再読み込み(&R)\tCtrl+R",      PICTURE_MENU_RELOAD
        MENUITEM "名前を付けて保存(&S)...\tCtrl+S", PICTURE_MENU_SAVE
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "コピー(&C)\tCtrl+C",          PICTURE_MENU_COPY
        MENUITEM "貼り付け(&P)\tCtrl+V",        PICTURE_MENU_PASTE
        MENUITEM "サイズを変更(&Z)...",         PICTURE_MENU_RESIZE
        MENUITEM SEPARATOR
        MENUITEM "トリミング",                  PICTURE_MENU_TRIM
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "実際のサイズ(&A)\tCtrl+0",    PICTURE_MENU_SAME
        MENUITEM "ズームイン(&I)\tCtrl++",      PICTURE_MENU_ZOOMIN
        MENUITEM "ズームアウト(&O)\tCtrl+-",    PICTURE_MENU_ZOOMOUT
        MENUITEM "ウインドウに合わせる(&W)",    PICTURE_MENU_FIT
        MENUITEM "拡大率を指定(&Z)...",         PICTURE_MENU_ZOOMCUSTOM
        MENUITEM SEPARATOR
        MENUITEM "前のページ",                  PICTURE_MENU_PREV
        MENUITEM "次のページ",                  PICTURE_MENU_NEXT
        MENUITEM SEPARATOR
        MENUITEM "左回転",                      PICTURE_MENU_ROTATE_LEFT
        MENUITEM "右回転",                      PICTURE_MENU_ROTATE_RIGHT
        MENUITEM "左右反転",                    PICTURE_MENU_FLIP_H
        MENUITEM SEPARATOR
        MENUITEM "黒背景",                      PICTURE_MENU_BG_BLACK
        MENUITEM "白背景",                      PICTURE_MENU_BG_WHITE
        MENUITEM "市松模様背景",                PICTURE_MENU_BG_CHECKER
        MENUITEM SEPARATOR
        MENUITEM "左上の色を透明化",            PICTURE_MENU_COLORKEY
    END
END

IDR_ARCHIVE_VIEWER_MENU MENU DISCARDABLE 
